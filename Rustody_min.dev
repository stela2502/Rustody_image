Bootstrap: docker
From: ubuntu:latest

%post
  # Update and install necessary packages
  apt update && apt install -y \
      bash \
      curl \
      gcc \
      clang \
      libc6-dev \
      libssl-dev \
      llvm \
      build-essential \
      cmake \
      git \
      perl \
      make \
      linux-headers-generic \
      llvm-dev \
      clang-14 \
      libclang-dev \
      libstdc++-12-dev

  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

  export PATH="$HOME/.cargo/bin:$PATH"
  echo 'export PATH="$HOME/.cargo/bin:$PATH"' >> ~/.bashrc

  rustup update 

  # Create the target directory for Rust binaries
  mkdir -p /usr/local/bin

  # install the image_cli not in /usr/local, but in /usr
  CARGO_INSTALL_ROOT=/usr cargo install --git https://github.com/stela2502/image_cli

  # Install quantify_bam
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/bam_tide.git
  mkdir -p /usr/local/share/bam_tide
  curl -L -o /usr/local/share/bam_tide/whitelist_map.bin https://raw.githubusercontent.com/stela2502/bam_tide/main/data/whitelist_map.bin

  # Clean up (Alpine does not need as much cleaning up as Debian/Ubuntu)
  rm -rf /var/cache/apk/*

%environment
  export PATH="/usr/local/bin:$PATH"
  export RustodyFiles="/opt/Rustody_files"
  export PATH="/root/.cargo/bin:$PATH"
