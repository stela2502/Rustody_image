Bootstrap: docker
From: ubuntu:latest

%post
  # Update and install necessary packages
  apt update && apt install -y \
      bash \
      curl \
      gcc \
      clang \
      libc6-dev \
      libssl-dev \
      llvm \
      build-essential \
      cmake \
      git \
      perl \
      make \
      linux-headers-generic \
      llvm-dev \
      clang-14 \
      libclang-dev \
      libstdc++-12-dev

  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

  export PATH="$HOME/.cargo/bin:$PATH"
  echo 'export PATH="$HOME/.cargo/bin:$PATH"' >> ~/.bashrc

  rustup update 

  # Create the target directory for Rust binaries
  mkdir -p /usr/local/bin

  # Clone and build Rustody
  git clone https://github.com/stela2502/Rustody.git
  cd Rustody
  cargo build -r
  ./install_resources_unix.sh
  cd ..
  rm -Rf Rustody
 
  TARGET=x86_64-unknown-linux-musl
  for repo in \
    https://github.com/stela2502/Rustody.git \
    https://github.com/stela2502/rust-geo-prep.git \
    https://github.com/stela2502/multi_subset_bam.git \
    https://github.com/stela2502/bam_aligner.git \
    https://github.com/stela2502/RustySparseMMX.git \
    https://github.com/stela2502/bam_tide.git \
    https://github.com/stela2502/bam_re_tagger.git \
    https://github.com/stela2502/regionomics.git 
  do
    cargo install --git "$repo" --target "$TARGET" --root /usr/local
  done

  # install the image_cli not in /usr/local, but in /usr
  CARGO_INSTALL_ROOT=/usr cargo install --git https://github.com/stela2502/image_cli

  # a really cool bigwig handling library:
  CARGO_INSTALL_ROOT=/usr/local cargo install bigtools

  # the 10x bamtofastq
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/10XGenomics/bamtofastq.git

  #my rust-geo-prep
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/rust-geo-prep.git

  # Install build multi_subset_bam
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/multi_subset_bam.git

  # Install bam_aligner
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/bam_aligner.git

  # Install RustySparseMMX
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/RustySparseMMX.git
  
  # Install quantify_bam
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/bam_tide.git
  mkdir -p /usr/local/share/bam_tide
  curl -L -o /usr/local/share/bam_tide/whitelist_map.bin https://raw.githubusercontent.com/stela2502/bam_tide/main/data/whitelist_map.bin

  # Install bam_re_tagger
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/bam_re_tagger.git

  # Install regionomics
  CARGO_INSTALL_ROOT=/usr/local cargo install --git https://github.com/stela2502/regionomics.git

  # Download the specific file from the Rustody repo
  curl -O https://github.com/stela2502/Rustody/min2//branch/filename

  # Clean up (Alpine does not need as much cleaning up as Debian/Ubuntu)
  rm -rf /var/cache/apk/*

%environment
  export PATH="/usr/local/bin:$PATH"
  export RustodyFiles="/opt/Rustody_files"
  export PATH="/root/.cargo/bin:$PATH"
